FROM maven:3.9.8-eclipse-temurin-21-alpine AS builder
WORKDIR /build

COPY pom.xml ./
COPY shared/pom.xml shared/
COPY studentbot/pom.xml studentbot/
COPY adminbot/pom.xml adminbot/

RUN mvn dependency:go-offline -pl shared,adminbot -am -q

COPY shared/src shared/src
COPY adminbot/src adminbot/src

RUN mvn package -pl shared,adminbot -am -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache tzdata
ENV TZ=Asia/Tashkent
WORKDIR /app
COPY --from=builder /build/adminbot/target/adminbot-1.0.0.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
