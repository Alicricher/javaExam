FROM maven:3.9.8-eclipse-temurin-21-alpine AS builder
WORKDIR /build

COPY pom.xml ./
COPY shared/pom.xml shared/
COPY studentbot/pom.xml studentbot/
COPY adminweb/pom.xml adminweb/

RUN mvn dependency:go-offline -pl shared,studentbot -am -q

COPY shared/src shared/src
COPY studentbot/src studentbot/src

RUN mvn package -pl shared,studentbot -am -DskipTests -q

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache tzdata
ENV TZ=Asia/Tashkent
WORKDIR /app
COPY --from=builder /build/studentbot/target/studentbot-1.0.0.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
