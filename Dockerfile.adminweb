FROM node:22-alpine AS frontend-builder
WORKDIR /frontend
COPY adminweb/frontend/package*.json ./
RUN npm ci
COPY adminweb/frontend/ .
RUN npm run build

FROM maven:3.9.8-eclipse-temurin-21-alpine AS builder
WORKDIR /build

COPY pom.xml ./
COPY shared/pom.xml shared/
COPY studentbot/pom.xml studentbot/
COPY adminweb/pom.xml adminweb/

RUN mvn dependency:go-offline -pl shared,adminweb -am -q

COPY shared/src shared/src
COPY adminweb/src adminweb/src
COPY --from=frontend-builder /frontend/dist adminweb/src/main/resources/static/

RUN mvn package -pl shared,adminweb -am -DskipTests -Dskip.npm=true -q

FROM eclipse-temurin:21-jre-alpine
RUN apk add --no-cache tzdata
ENV TZ=Asia/Tashkent
WORKDIR /app
COPY --from=builder /build/adminweb/target/adminweb-1.0.0.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]
